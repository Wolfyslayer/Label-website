{
  "name": "wolfyslayer-records",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "validate:content": "tsx scripts/validate-content.ts",
    "import:spotify": "tsx scripts/import-spotify.ts",
    "import:youtube-music": "tsx scripts/import-youtube-music.ts",
    "prepare:release-covers": "node scripts/prepare-release-covers.mjs",
    "prepare:hero-images": "node scripts/prepare-hero-images.mjs",
    "verify:release-covers": "node scripts/verify-release-covers.mjs",
    "test:spotify": "tsx scripts/test-spotify-import.ts",
    "build": "npm run validate:content && npm run prepare:release-covers && npm run verify:release-covers && npm run prepare:hero-images && STATIC_EXPORT=1 NEXT_PUBLIC_STATIC_HOSTING=1 next build",
    "build:pages": "NEXT_PUBLIC_SITE_URL=https://wolfyslayer.online NEXT_PUBLIC_BASE_PATH= npm run build",
    "build:node": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:quality": "npm run lint && npm run typecheck",
    "sync-artist-images": "node scripts/sync-artist-images.mjs",
    "generate-brand-icons": "node scripts/generate-brand-icons.mjs",
    "sync:icons": "node scripts/sync-public-icons.mjs",
    "validate:seo": "node scripts/validate-seo-export.mjs",
    "verify:assets": "node scripts/verify-asset-paths.mjs",
    "verify:export": "node scripts/verify-export-integrity.mjs",
    "test:manager": "tsx scripts/test-manager-export.ts",
    "test:e2e": "playwright test",
    "test:e2e:responsive": "playwright test tests/e2e/responsive-overflow.spec.ts",
    "audit:lighthouse": "node scripts/lighthouse-audit.mjs",
    "audit:cache": "node scripts/audit-production-cache.mjs",
    "check:performance": "node scripts/check-performance-budgets.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.49.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.2",
    "lucide-react": "^0.475.0",
    "next": "^15.1.0",
    "next-intl": "^3.26.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.1.0",
    "lighthouse": "^12.6.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
