# Public site URL (used for SEO, sitemap, Open Graph)
# Custom domain at root: https://www.yourlabel.com
# GitHub project site: https://YOUR_USER.github.io (base path set separately)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GitHub Pages project site only (leave empty for custom domain at root)
# NEXT_PUBLIC_BASE_PATH=Label-website

# Static export (set automatically by npm run build)
# NEXT_PUBLIC_STATIC_HOSTING=1

# Contact on static hosting (public Formspree endpoint — no secrets)
# NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=https://formspree.io/f/fYOUR_FORM_ID

# Optional public contact / press emails (shown on site when set)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRESS_EMAIL=

# Optional social profile URLs
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_SPOTIFY=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_X=

# Supabase (optional — site works from seed data without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: contact form inserts + admin operations bypassing RLS where needed
SUPABASE_SERVICE_ROLE_KEY=

# Alternative contact delivery: HTTPS webhook (e.g. Slack, Zapier, Formspree backend)
CONTACT_WEBHOOK_URL=

# Optional newsletter provider (not wired until you add integration)
# NEWSLETTER_PROVIDER_API_KEY=
